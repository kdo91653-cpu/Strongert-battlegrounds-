-- ============ COOLDOWN UI ============
local cooldownActive      = false
local cooldownStartTick   = 0
local heartBeatConnection = nil
local endGlowTween        = nil

local function clearCooldown()
    if heartBeatConnection then
        heartBeatConnection:Disconnect()
        heartBeatConnection = nil
    end
    cooldownActive = false
    RightCircle.ImageTransparency = 1
    LeftCircle.ImageTransparency  = 1
    CooldownText.TextTransparency = 1
    CooldownText.Text = ""
    if endGlowTween then endGlowTween:Cancel(); endGlowTween = nil end
end

local function startCooldown()
    if cooldownActive then return end
    cooldownActive = true
    cooldownStartTick = tick()
    RightCircle.ImageTransparency = 0
    LeftCircle.ImageTransparency  = 0
    RightMask.Rotation = 0
    LeftMask.Rotation  = 0
    CooldownText.TextTransparency = 0
    CooldownText.Text = tostring(COOLDOWN_TIME)

    if heartBeatConnection then heartBeatConnection:Disconnect() end
    heartBeatConnection = RunService.Heartbeat:Connect(function()
        if S.Destroyed then clearCooldown(); return end
        local elapsed    = tick() - cooldownStartTick
        local remaining  = math.max(0, COOLDOWN_TIME - elapsed)
        local progress   = math.min(1, elapsed / COOLDOWN_TIME)
        local displayNum = math.ceil(remaining)
        CooldownText.Text = (displayNum > 0) and tostring(displayNum) or ""

        if progress <= 0.5 then
            RightMask.Rotation = progress * 360
            LeftMask.Rotation  = 0
        else
            RightMask.Rotation = 180
            LeftMask.Rotation  = (progress - 0.5) * 360
        end

        if remaining <= 0 then
            clearCooldown()
            local origStrokeColor     = Stroke.Color
            local origStrokeThickness = Stroke.Thickness
            local glowInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, true)
            if endGlowTween then endGlowTween:Cancel() end
            endGlowTween = TS:Create(Stroke, glowInfo, {
                Color = Color3.fromRGB(255, 255, 150),
                Thickness = 4
            })
            endGlowTween:Play()
            endGlowTween.Completed:Once(function()
                Stroke.Color = origStrokeColor
                Stroke.Thickness = origStrokeThickness
                endGlowTween = nil
            end)
        end
    end)
end

-- ============ ORBIT LOGIC ============
local state              = "IDLE"
local targetPlayer       = nil
local orbitStartTime     = 0
local savedCameraSubject = nil
local cameraFocusPart    = nil

local highlight = Instance.new("Highlight")
highlight.FillColor = Color3.fromRGB(255, 0, 0)
highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
highlight.FillTransparency = 0.5
highlight.Parent = nil

local function clearTarget() highlight.Parent = nil; targetPlayer = nil end
local function setState(s) state = s end

local function isPlayerAlive(plr)
    local char = plr and plr.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end

local function scanNearestPlayer()
    if not isPlayerAlive(Player) then return nil end
    local myRoot = Player.Character.HumanoidRootPart
    local nearest, nearestDist = nil, SCAN_RADIUS
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and isPlayerAlive(other) then
            local dist = (other.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
            if dist < nearestDist then nearestDist, nearest = dist, other end
        end
    end
    return nearest
end

local function showMarker(plr)
    if not plr or not plr.Character then return end
    highlight.Parent = plr.Character
end
local function hideMarker() highlight.Parent = nil end

local function getSmoothStarPosition(t, targetPos)
    local angle = t * STAR_SPEED
    local r = STAR_RADIUS * (1 + STAR_AMPLITUDE * math.cos(STAR_POINTS * angle))
    return targetPos + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
end

local function getOrCreateCameraFocusPart()
    if not cameraFocusPart then
        cameraFocusPart = Instance.new("Part")
        cameraFocusPart.Name = "CameraFocus"
        cameraFocusPart.Transparency = 1
        cameraFocusPart.CanCollide = false
        cameraFocusPart.Anchored = true
        cameraFocusPart.Size = Vector3.new(0.1, 0.1, 0.1)
        cameraFocusPart.Parent = workspace
    end
    return cameraFocusPart
end

local function stopOrbitAnimTrack()
    if currentOrbitAnimTrack then
        pcall(function() currentOrbitAnimTrack:Stop(0.1) end)
        currentOrbitAnimTrack = nil
    end
end

local function requestOrbit()
    if S.Destroyed then return end
    if state ~= "READY" or not targetPlayer then return end
    setState("ORBITING")
    orbitStartTime = tick()
    startCooldown()

    savedCameraSubject = Camera.CameraSubject
    local focusPart = getOrCreateCameraFocusPart()
    focusPart.Position = targetPlayer.Character.HumanoidRootPart.Position
    Camera.CameraSubject = focusPart
    Camera.CameraType    = Enum.CameraType.Custom

    local char = Player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
            animator.Parent = humanoid
            stopOrbitAnimTrack()
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://133917752081592"
            local tk = animator:LoadAnimation(anim)
            tk.Priority = Enum.AnimationPriority.Action4
            tk:Play(0)
            task.spawn(function()
                task.wait(0.08)
                if S.Destroyed then return end
                if tk and tk.IsPlaying then tk:AdjustSpeed(0) end
            end)
            currentOrbitAnimTrack = tk
        end
    end

    local starPos = getSmoothStarPosition(tick(), targetPlayer.Character.HumanoidRootPart.Position)
    local direction = (targetPlayer.Character.HumanoidRootPart.Position - starPos).Unit
    local desiredCamPos = starPos + direction * 22 + Vector3.new(0, 4, 0)
    Camera.CFrame = CFrame.lookAt(desiredCamPos, targetPlayer.Character.HumanoidRootPart.Position)
end

local function resetToIdle()
    orbitStartTime = 0
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = savedCameraSubject or (Player.Character and Player.Character:FindFirstChild("Humanoid"))
    end)
    savedCameraSubject = nil
    if cameraFocusPart then cameraFocusPart:Destroy(); cameraFocusPart = nil end
    hideMarker()
    clearTarget()
    stopOrbitAnimTrack()
    setState("IDLE")
end

local function finishOrbit()
    if not targetPlayer or not isPlayerAlive(targetPlayer) then resetToIdle(); return end
    local targetRoot = targetPlayer.Character.HumanoidRootPart
    local behindPos  = targetRoot.Position - targetRoot.CFrame.LookVector * BEHIND_DISTANCE

    -- Chỉ phát sound DUY NHẤT 1 lần ở đây
    teleportWithSound(CFrame.new(behindPos, targetRoot.Position))

    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = savedCameraSubject or (Player.Character and Player.Character:FindFirstChild("Humanoid"))
    end)
    savedCameraSubject = nil
    if cameraFocusPart then cameraFocusPart:Destroy(); cameraFocusPart = nil end
    hideMarker()
    clearTarget()
    stopOrbitAnimTrack()
    setState("IDLE")
end

local function onLocalPlayerDied() resetToIdle(); clearCooldown() end

local function onCharacterAdded(char)
    if S.Destroyed then return end
    resetToIdle()
    clearCooldown()
    local hum = char:WaitForChild("Humanoid")
    track(hum.Died:Connect(function()
        if S.Destroyed then return end
        onLocalPlayerDied()
    end))
end

if Player.Character then onCharacterAdded(Player.Character) end
track(Player.CharacterAdded:Connect(onCharacterAdded))

-- ============ RUN ============
local function Run()
    if S.Destroyed or cooldownActive or DidDrag then return end
    if state == "READY" then requestOrbit() end
end

track(Button.MouseButton1Click:Connect(Run))

-- ============ RENDER LOOP ============
track(RunService.RenderStepped:Connect(function()
    if S.Destroyed then return end
    if not isPlayerAlive(Player) then return end
    local myRoot = Player.Character.HumanoidRootPart

    if state == "IDLE" then
        local nearest = scanNearestPlayer()
        if nearest then
            targetPlayer = nearest
            showMarker(nearest)
            setState("READY")
        end

    elseif state == "READY" then
        if not targetPlayer or not isPlayerAlive(targetPlayer) then
            resetToIdle()
        else
            local dist = (targetPlayer.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
            if dist > SCAN_RADIUS then resetToIdle() end
        end

    elseif state == "ORBITING" then
        if not targetPlayer or not isPlayerAlive(targetPlayer) then
            resetToIdle(); return
        end

        local targetRoot = targetPlayer.Character.HumanoidRootPart
        local elapsed = tick() - orbitStartTime

        if elapsed >= ORBIT_DURATION then finishOrbit(); return end
        if myRoot.Position.Y < -500 then resetToIdle(); return end

        local starPos = getSmoothStarPosition(tick(), targetRoot.Position)

        -- Teleport KHÔNG sound mỗi frame (sound chỉ ở finishOrbit)
        Player.Character:PivotTo(CFrame.new(starPos, targetRoot.Position))

        if cameraFocusPart then
            cameraFocusPart.Position = cameraFocusPart.Position:Lerp(targetRoot.Position, CAMERA_LERP_ALPHA)
        end
    end
end))

-- ============ LOCK API ============
local function SetLocked(value)
    S.Locked = value == true
    if S.Locked then
        dragging  = false
        DidDrag   = false
        dragInput = nil
    end
end

-- ============ DESTROY ============
local function Destroy()
    if S.Destroyed then return end
    S.Destroyed = true
    pcall(resetToIdle)
    pcall(clearCooldown)
    pcall(stopOrbitAnimTrack)

    if teleportSound then pcall(function() teleportSound:Destroy() end) end
    if cameraFocusPart then pcall(function() cameraFocusPart:Destroy() end) end
    if highlight then pcall(function() highlight:Destroy() end) end

    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}

    local g = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild(GUI_NAME)
    if g then g:Destroy() end
end

return {
    Destroy   = Destroy,
    Run       = Run,
    SetLocked = SetLocked,
    Name      = GUI_NAME,
}
