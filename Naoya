end

-- camera shake: FIX (1) random float, (2) cộng dồn lên CFrame hiện tại
local function cameraShake(intensity, duration)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local startTime = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if S.Destroyed or tick() - startTime >= duration then
            conn:Disconnect()
            return
        end
        local offset = Vector3.new(
            (math.random() * 2 - 1) * intensity,
            (math.random() * 2 - 1) * intensity,
            0
        )
        camera.CFrame = camera.CFrame * CFrame.new(offset)
    end)
end

local function createRig()
    if S.Destroyed then return nil end
    if not character or not character.Parent then return nil end
    character.Archivable = true
    local clone = character:Clone()
    character.Archivable = false
    if not clone then return nil end

    for _, child in ipairs(clone:GetDescendants()) do
        if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("Tool") then
            child:Destroy()
        end
    end

    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.AutoRotate = false
    end

    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
            part.Massless = true
            part.Material = Enum.Material.Neon
            part.Color = Color3.fromRGB(0, 170, 255)
            part.Transparency = 0.4
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 170, 255)
    hl.OutlineColor = Color3.fromRGB(0, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = clone

    local rootClone = clone:FindFirstChild("HumanoidRootPart")
    if rootClone then
        local attachment = Instance.new("Attachment")
        attachment.Parent = rootClone
        local particle = Instance.new("ParticleEmitter")
        particle.Texture = "rbxassetid://7732153556"
        particle.Color = ColorSequence.new(Color3.fromRGB(0, 170, 255))
        particle.Size = NumberSequence.new(0.3)
        particle.Lifetime = NumberRange.new(0.2, 0.5)
        particle.Rate = 20
        particle.SpreadAngle = Vector2.new(360, 360)
        particle.Parent = attachment
    end

    clone.Parent = workspace
    table.insert(ActiveRigs, clone)
    return clone
end

local function playAnimationSafe(rig, animId)
    if S.Destroyed or not rig then return nil end
    local hum = rig:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local animation = Instance.new("Animation")
    animation.AnimationId = animId
    local tk = animator:LoadAnimation(animation)
    if not tk then return nil end
    tk.Priority = Enum.AnimationPriority.Action
    tk:Play(0)
    return tk
end

local function fadeAndDestroy(rig, delayBeforeFade)
    task.delay(delayBeforeFade, function()
        if S.Destroyed or not rig or not rig.Parent then return end
        local parts = {}
        for _, part in ipairs(rig:GetDescendants()) do
            if part:IsA("BasePart") then table.insert(parts, part) end
        end
        for _, part in ipairs(parts) do
            TS:Create(part, TweenInfo.new(FADE_TIME, Enum.EasingStyle.Linear), {Transparency = 1}):Play()
        end
        task.delay(FADE_TIME + 0.1, function()
            if rig and rig.Parent then rig:Destroy() end
        end)
    end)
end

-- ============ MAIN ABILITY ============
local function executeAbility()
    if S.Destroyed or cooldownActive or S.Running then return end
    if not character or not character.Parent or not rootPart then return end

    S.Running = true
    startCooldownUI(ABILITY_TOTAL_COOLDOWN)

    local startPos    = rootPart.Position
    local lookVector  = rootPart.CFrame.LookVector
    local rightVector = rootPart.CFrame.RightVector

    local rigSpawnCFrames = {}
    for i = 1, NUM_RIGS do
        local offset = lookVector * (SPACING * i)
            + rightVector * SIDE[i]
            + Vector3.new(0, HEIGHT[i], 0)
        local pos = startPos + offset
        table.insert(rigSpawnCFrames, CFrame.lookAt(pos, pos + lookVector))
    end

    for i = 1, NUM_RIGS do
        if S.Destroyed or not character or not character.Parent then break end
        local rig = createRig()
        if rig then
            rig:PivotTo(rigSpawnCFrames[i])
            playAnimationSafe(rig, ANIM_IDS[i])
            fadeAndDestroy(rig, RIG_LIFETIME)
            cameraShake(0.2 + i * 0.05, 0.1)
        end
        if i < NUM_RIGS then
            task.wait(RIG_APPEAR_DELAY)
            if S.Destroyed then S.Running = false; return end
        end
    end

    task.wait(TELEPORT_DELAY)
    if S.Destroyed or not character or not character.Parent then S.Running = false; return end

    local finalPos = rigSpawnCFrames[NUM_RIGS].Position + lookVector * SHORT_DASH
    local finalCF  = CFrame.lookAt(finalPos, finalPos + lookVector)

    createFlash(finalPos)
    createRing(finalPos)
    cameraShake(0.5, 0.15)

    local tween = TS:Create(
        rootPart,
        TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Linear),
        {CFrame = finalCF}
    )
    tween:Play()
    tween.Completed:Wait()
    if S.Destroyed then S.Running = false; return end

    task.wait(COOLDOWN)
    S.Running = false
end

-- ============ RUN ============
local function Run()
    executeAbility()
end

track(Button.MouseButton1Click:Connect(function()
    if S.Destroyed or cooldownActive or DidDrag then return end
    executeAbility()
end))

track(UIS.InputBegan:Connect(function(input, gameProcessed)
    if S.Destroyed or gameProcessed then return end
    if input.KeyCode ~= KEY then return end
    if cooldownActive then return end
    executeAbility()
end))

-- ============ LOCK API ============
local function SetLocked(value)
    S.Locked = value == true
    if S.Locked then
        dragging  = false
        DidDrag   = false
        dragInput = nil
    end
end

-- ============ DESTROY ============
local function Destroy()
    if S.Destroyed then return end
    S.Destroyed = true
    S.Running   = false
    pcall(clearCooldown)

    for _, rig in ipairs(ActiveRigs) do
        pcall(function() if rig and rig.Parent then rig:Destroy() end end)
    end
    ActiveRigs = {}

    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}

    local g = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild(GUI_NAME)
    if g then g:Destroy() end
end

return {
    Destroy   = Destroy,
    Run       = Run,
    SetLocked = SetLocked,
    Name      = GUI_NAME,
}
