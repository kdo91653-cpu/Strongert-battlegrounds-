-- ============ COOLDOWN UI ============
local cooldownActive          = false
local cooldownStartTick       = 0
local currentCooldownDuration = 0
local heartBeatConnection     = nil
local endGlowTween            = nil

local function clearCooldown()
    if heartBeatConnection then heartBeatConnection:Disconnect(); heartBeatConnection = nil end
    cooldownActive = false
    RightCircle.ImageTransparency = 1
    LeftCircle.ImageTransparency  = 1
    CooldownText.TextTransparency = 1
    CooldownText.Text = ""
    if endGlowTween then endGlowTween:Cancel(); endGlowTween = nil end
end

local function startCooldownUI(duration)
    if cooldownActive then return end
    cooldownActive = true
    cooldownStartTick = tick()
    currentCooldownDuration = duration

    RightCircle.ImageTransparency = 0
    LeftCircle.ImageTransparency  = 0
    RightMask.Rotation = 0
    LeftMask.Rotation  = 0
    CooldownText.TextTransparency = 0
    CooldownText.Text = tostring(math.ceil(duration))

    if heartBeatConnection then heartBeatConnection:Disconnect() end
    heartBeatConnection = RunService.Heartbeat:Connect(function()
        if S.Destroyed then clearCooldown(); return end
        local elapsed    = tick() - cooldownStartTick
        local remaining  = math.max(0, currentCooldownDuration - elapsed)
        local progress   = math.min(1, elapsed / currentCooldownDuration)
        local displayNum = math.ceil(remaining)
        CooldownText.Text = (displayNum > 0) and tostring(displayNum) or ""

        if progress <= 0.5 then
            RightMask.Rotation = progress * 360
            LeftMask.Rotation  = 0
        else
            RightMask.Rotation = 180
            LeftMask.Rotation  = (progress - 0.5) * 360
        end

        if remaining <= 0 then
            clearCooldown()
            local origStrokeColor     = Stroke.Color
            local origStrokeThickness = Stroke.Thickness
            local glowInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, true)
            if endGlowTween then endGlowTween:Cancel() end
            endGlowTween = TS:Create(Stroke, glowInfo, {
                Color = Color3.fromRGB(255, 255, 150),
                Thickness = 4
            })
            endGlowTween:Play()
            endGlowTween.Completed:Once(function()
                Stroke.Color = origStrokeColor
                Stroke.Thickness = origStrokeThickness
                endGlowTween = nil
            end)
        end
    end)
end

